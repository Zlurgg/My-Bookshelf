<?xml version="1.0" encoding="utf-8"?>
<!--
   Data extraction rules for Android 12+ backup and device transfer.
   We exclude the Room database and DataStore because:
   - Database is synced via Firestore (cloud is source of truth)
   - Restoring old database causes "ghost" orphan data issues
   - Fresh install should pull from Firestore, not local backup
-->
<data-extraction-rules>
    <cloud-backup>
        <!-- Exclude Room database - restored from Firestore -->
        <exclude domain="database" path="mybookshelf.db"/>
        <exclude domain="database" path="mybookshelf.db-shm"/>
        <exclude domain="database" path="mybookshelf.db-wal"/>

        <!-- Exclude DataStore - sync metadata should be fresh -->
        <exclude domain="file" path="datastore/"/>

        <!-- Exclude Firebase cache -->
        <exclude domain="file" path="com.google.firebase.crashlytics/"/>
    </cloud-backup>

    <device-transfer>
        <!-- Same exclusions for device-to-device transfer -->
        <exclude domain="database" path="mybookshelf.db"/>
        <exclude domain="database" path="mybookshelf.db-shm"/>
        <exclude domain="database" path="mybookshelf.db-wal"/>
        <exclude domain="file" path="datastore/"/>
    </device-transfer>
</data-extraction-rules>
