rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ==================== User Data ====================
    // Users can only read/write their own data

    match /users/{userId} {
      // User profile document
      allow read, write: if request.auth != null && request.auth.uid == userId;

      // User's books collection
      match /books/{bookId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // User's bookshelves collection
      match /bookshelves/{shelfId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // ==================== Book Clubs ====================
    // Collaborative shelves with owner and member access

    match /bookClubs/{clubCode} {
      // Any authenticated user can read (needed for code checking and joining)
      allow read: if request.auth != null;

      // Allow creation if user sets themselves as creator
      allow create: if request.auth != null
        && request.resource.data.created_by == request.auth.uid;

      // Only creator can update/delete
      allow update, delete: if request.auth != null
        && resource.data.created_by == request.auth.uid;

      // Members subcollection
      match /members/{memberId} {
        // Creator can manage all members
        allow read, write: if request.auth != null
          && get(/databases/$(database)/documents/bookClubs/$(clubCode)).data.created_by == request.auth.uid;

        // Users can add/remove themselves
        allow read, write: if request.auth != null
          && request.auth.uid == memberId;
      }

      // Books subcollection
      match /books/{bookId} {
        // Creator can manage books
        allow read, write: if request.auth != null
          && get(/databases/$(database)/documents/bookClubs/$(clubCode)).data.created_by == request.auth.uid;

        // Members can read books
        allow read: if request.auth != null
          && exists(/databases/$(database)/documents/bookClubs/$(clubCode)/members/$(request.auth.uid));
      }
    }

    // ==================== Shared Shelves ====================
    // Public read for discovery, owner-only write

    match /sharedShelves/{shareCode} {
      // Anyone authenticated can read shared shelf metadata (for discovery)
      allow read: if request.auth != null;

      // Only owner can create/update/delete
      allow create: if request.auth != null
        && request.resource.data.owner_id == request.auth.uid;

      allow update: if request.auth != null
        && resource.data.owner_id == request.auth.uid;

      allow delete: if request.auth != null
        && resource.data.owner_id == request.auth.uid;

      // Allow users to add themselves to subscriber_ids
      allow update: if request.auth != null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['subscriber_ids'])
        && (
          // Adding self to subscribers
          request.resource.data.subscriber_ids.hasAll(resource.data.subscriber_ids)
          && request.resource.data.subscriber_ids.size() == resource.data.subscriber_ids.size() + 1
          && request.auth.uid in request.resource.data.subscriber_ids
          // OR removing self from subscribers
          || resource.data.subscriber_ids.hasAll(request.resource.data.subscriber_ids)
          && request.resource.data.subscriber_ids.size() == resource.data.subscriber_ids.size() - 1
          && !(request.auth.uid in request.resource.data.subscriber_ids)
        );
    }

    // ==================== Helper Functions ====================

    // Check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Check if user is the resource owner
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
  }
}
