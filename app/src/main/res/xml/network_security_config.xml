<?xml version="1.0" encoding="utf-8"?>
<!--
    RELEASE network security configuration.
    Enforces HTTPS for all connections - NO cleartext HTTP allowed.
    Debug builds use a separate config that allows emulator connections.
-->
<network-security-config>
    <!-- Base configuration: block all cleartext traffic -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <!-- Trust only system certificate authorities -->
            <certificates src="system" />
        </trust-anchors>
    </base-config>

    <!-- Domain-specific configurations for APIs -->
    <domain-config cleartextTrafficPermitted="false">
        <!-- Open Library API - HTTPS only -->
        <domain includeSubdomains="true">openlibrary.org</domain>

        <!-- GitHub Pages (share links) - HTTPS only -->
        <domain includeSubdomains="true">zlurgg.github.io</domain>
    </domain-config>
</network-security-config>
