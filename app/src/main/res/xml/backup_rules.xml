<?xml version="1.0" encoding="utf-8"?>
<!--
   Backup rules for Android Auto Backup.
   We exclude the Room database and DataStore because:
   - Database is offline-first (Room is source of truth for personal data)
   - Restoring a stale database causes schema mismatch crashes
   - Book club data is restored from Firestore on sign-in
-->
<full-backup-content>
    <!-- Exclude Room database -->
    <exclude domain="database" path="my_bookshelf.db"/>
    <exclude domain="database" path="my_bookshelf.db-shm"/>
    <exclude domain="database" path="my_bookshelf.db-wal"/>

    <!-- Exclude DataStore and SharedPreferences - must be fresh on reinstall -->
    <exclude domain="file" path="datastore/"/>
    <exclude domain="sharedpref" path="welcome.xml"/>

    <!-- Exclude Firebase cache -->
    <exclude domain="file" path="com.google.firebase.crashlytics/"/>
</full-backup-content>
