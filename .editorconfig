# EditorConfig for MyBookshelf
# https://editorconfig.org

root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
insert_final_newline = true
trim_trailing_whitespace = true

[*.{kt,kts}]
indent_size = 4
max_line_length = 120

# ktlint specific settings
ktlint_standard_no-wildcard-imports = disabled
ktlint_standard_package-name = disabled
# Compose uses PascalCase for @Composable functions
ktlint_standard_function-naming = disabled
# Allow comments in argument/parameter lists
ktlint_standard_comment-wrapping = disabled
ktlint_standard_value-argument-comment = disabled
ktlint_standard_value-parameter-comment = disabled
# Don't enforce function body on same line
ktlint_standard_function-signature = disabled
# Don't enforce trailing commas
ktlint_standard_trailing-comma-on-call-site = disabled
ktlint_standard_trailing-comma-on-declaration-site = disabled

[*.xml]
indent_size = 4

[*.{json,yml,yaml}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

# Test files - more lenient line length for descriptive test names and assertions
[**/test/**/*.kt]
max_line_length = 200

[**/androidTest/**/*.kt]
max_line_length = 200

[*.gradle.kts]
indent_size = 4

[Makefile]
indent_style = tab
