#!/bin/bash

# Pre-commit hook for MyBookshelf
# Runs ktlint check on staged Kotlin files before commit

echo "Running pre-commit checks..."

# Get list of staged Kotlin files
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep '\.kt$')

if [ -z "$STAGED_FILES" ]; then
    echo "No Kotlin files staged for commit."
    exit 0
fi

echo "Checking ${STAGED_FILES} with ktlint..."

# Run ktlint check
./gradlew ktlintCheck --daemon

KTLINT_EXIT_CODE=$?

if [ $KTLINT_EXIT_CODE -ne 0 ]; then
    echo ""
    echo "ktlint check failed. Please fix the issues above."
    echo "You can run './gradlew ktlintFormat' to auto-fix some issues."
    echo ""
    exit 1
fi

echo "Pre-commit checks passed!"
exit 0
